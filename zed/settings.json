{
    "cli_default_open_behavior": "existing_window",
    "disable_ai": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false,
    },
    "debugger": {
        "stepping_granularity": "line",
    },
    "project_panel": {
        "folder_indicator": "both",
        "file_icons": true,
        "title_tooltip_delay": {
            "custom": 1500,
        },
        "default_width": 247.0,
        "dock": "left",
    },
    "agent_ui_font_size": 16.0,
    "ui_font_weight": 450.0,
    "ui_font_family": "JetBrains Mono",
    "hide_mouse": "on_typing_and_action",
    "cursor_animation": {
        "enabled": true,
    },
    "accessible_mode": false,
    "theme": "Lucent Blur Flat [Light]",
    "icon_theme": "Bearded Icon Theme",

    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 16,
    "buffer_font_weight": 500.0,
    "enable_font_ligatures": true,

    "format_on_save": "on",
    "show_line_highlights": "none",
    "autosave": "off",
    "cursor_blink": true,
    "cursor_shape": "bar",
    "tab_size": 4,
    "hard_tabs": false,
    "autofit_brackets": true,
    "remove_trailing_whitespace": true,
    "ensure_final_newline": true,
    "show_whitespaces": "selection",
    "bracket_pair_colorization": {
        "enabled": true,
    },
    "auto_closing_pairs": {
        "\"": "\"",
        "'": "'",
        "(": ")",
        "[": "]",
        "{": "}",
        "<": ">",
    },

    "languages": {
        "C#": {
            "tab_size": 4,
            "format_on_save": "on",
        },
        "C++": {
            "tab_size": 4,
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": [
                        "-style={BasedOnStyle: LLVM, BreakBeforeBraces: Allman, IndentWidth: 4}",
                    ],
                },
            },
        },

        "Python": {
            "tab_size": 4,
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": ["-", "-q"],
                },
            },
        },
    },
    "dap": {
        "CodeLLDB": {
            "binary": "/usr/bin/lldb-dap",
            "args": [],
        },
    },
    "theme_overrides": {
        "Lucent Blur Flat [Light]": {
            "search.match_background": "#3a445460",
            "editor.document_highlight.read_background": "#ffffff15", // Тонкая белая подсветка с прозрачностью 15%
            "editor.document_highlight.write_background": "#ffffff15",
            "background": "#00000045",
            "title_bar.background": "#00000045",
            "status_bar.background": "#00000045",
            "editor.background": "#00000000",
            "panel.background": "#00000000",
            "border": "#00000000",
            "editor.active_line.background": "#00000000",

            "tab_bar.background": "#00000001",
            "tab.active_background": "#00000001",
            "tab.inactive_background": "#00000001",

            "elevated_surface.background": "#00000000",
            "element.background": "#00000000",
            "element.hover": "#ffffff10",
            "element.active": "#ffffff18",
            "element.selected": "#ffffff15",
            "ghost_element.hover": "#ffffff10",
            "ghost_element.active": "#ffffff18",
            "ghost_element.selected": "#ffffff15",

            "panel.focused_border": "#00000000",

            "text.accent": "#ffffff",

            "terminal.ansi.cyan": "#ffffff",
            "terminal.ansi.bright_cyan": "#ffffff",

            "syntax": {
                "comment": { "color": "#a1a1a1" },
            },
            "editor.line_number": "#ffffff80",
            "editor.active_line_number": "#ffffff",
            "players": [
                {
                    "cursor": "#333333",
                    "selection": "#00000018",
                },
            ],
        },
    },
}
