{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Active File",
            "type": "shell",
            "command": "/home/camelcase/bin/vsc-run.sh",
            "args": [
                "${file}",
                "${fileExtname}",
                "${fileDirname}",
                "${fileBasenameNoExtension}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            }
        }
    ]
}