[
    {
        "label": "Run Active File",
        "command": "/home/camelcase/bin/zed-run.sh",
        "args": ["$ZED_FILE", "$ZED_WORKTREE_ROOT"],
        "shell": "system",
        "show": "always",
        "focus": true,
        "capture_output": false,
        "reevaluate_context": true,
    },
    {
        "label": "Activate Python Venv Terminal",
        "command": "fish",
        "args": [
            "-c",
            "cd \"$ZED_WORKTREE_ROOT\"; if not test -d .venv; echo '==== Creating Python Venv ===='; python3 -m venv .venv; end; bash --init-file .venv/bin/activate",
        ],
        "shell": "system",
        "show": "always",
        "focus": true,
    },
]
