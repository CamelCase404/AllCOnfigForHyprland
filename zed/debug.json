[
    {
        "label": "Debug active Python file (Venv)",
        "adapter": "Debugpy",
        "program": "$ZED_FILE",
        "request": "launch",
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "Debug active C++ file",
        "adapter": "CodeLLDB",
        "program": "$ZED_WORKTREE_ROOT/debug_bin",
        "request": "launch",
        "cwd": "$ZED_WORKTREE_ROOT",
        "build": {
            "command": "g++",
            "args": ["-g", "$ZED_FILE", "-o", "$ZED_WORKTREE_ROOT/debug_bin"],
        },
    },
]
