[
  {
    "context": "Workspace",
    "bindings": {
      // F5 запускает встроенный легковесный дебаггер Zed
      "f5": "debugger::Start"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      // Ctrl+Space запускает таску "Run Active File"
      "ctrl-space": ["task::Spawn", { "task_name": "Run Active File" }],
      // Переименование сущностей (Перенос с F2 на Shift+R)
      "shift-r": "editor::Rename"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "shift-r": "editor::Rename"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "f2": "editor::Rename"
    }
  }
]
